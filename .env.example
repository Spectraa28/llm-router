# ── Gemini API ────────────────────────────────────────────────────────────────
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Router Config ─────────────────────────────────────────────────────────────
# Probability threshold for routing to PRO model
# Lower = more queries go to PRO (higher accuracy, higher cost)
# Higher = more queries go to LITE (lower cost, lower accuracy)
COMPLEXITY_THRESHOLD=0.45

# ── Semantic Cache ────────────────────────────────────────────────────────────
# Cosine similarity threshold for cache hits
# Higher = stricter matching, fewer hits
# Lower = more hits, risk of returning slightly mismatched answers
CACHE_SIMILARITY_THRESHOLD=0.88

# Directory to persist FAISS index and metadata
CACHE_STORE_DIR=cache_store

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_EXPERIMENT_NAME=Simple Deterministic Router

# ── Gemini Timeout ────────────────────────────────────────────────────────────
# Seconds before threading timeout triggers fallback chain
GEMINI_TIMEOUT=10